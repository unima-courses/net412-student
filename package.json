{
  "name": "net412-lab-client",
  "version": "0.1.0",
  "description": "NET412 local practical lab client",
  "author": "NET412 course team",
  "private": true,
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "start:web": "node src/server.js",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win zip",
    "dist:win-installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {"@xterm/xterm": "^6.0.0", "@xterm/addon-fit": "^0.11.0", "dockerode": "^5.0.1", "express": "^5.0.0", "ws": "^8.0.0"},
  "devDependencies": {"@tailwindcss/vite": "^4.1.0", "daisyui": "^5.0.0", "electron": "^44.4.4", "electron-builder": "^26.0.0", "tailwindcss": "^4.1.0", "vite": "^7.0.0"},
  "build": {"appId": "mw.ac.unima.net412.lab", "productName": "NET412 Lab", "directories": {"output": "release"}, "files": ["electron.js", "src/server.js", "src/labs/**/*.js", "web-dist/**/*", "package.json"], "extraResources": [{"from": "lab", "to": "lab"}], "linux": {"target": "AppImage", "category": "Education"}, "win": {"target": "nsis"}}
}
